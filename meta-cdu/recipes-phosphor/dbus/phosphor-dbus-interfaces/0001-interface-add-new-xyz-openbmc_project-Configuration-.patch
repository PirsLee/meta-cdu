diff --git a/gen/xyz/openbmc_project/Configuration/UARTPort/meson.build b/gen/xyz/openbmc_project/Configuration/UARTPort/meson.build
new file mode 100644
index 0000000..fec6b28
--- /dev/null
+++ b/gen/xyz/openbmc_project/Configuration/UARTPort/meson.build
@@ -0,0 +1,40 @@
+# Generated file; do not modify.
+
+sdbusplus_current_path = 'xyz/openbmc_project/Configuration/UARTPort'
