@@ -128,6 +129,30 @@ generated_markdown += custom_target(
     build_by_default: should_generate_markdown,
 )
 
+generated_markdown += custom_target(
+    'xyz/openbmc_project/Configuration/UARTPort__markdown'.underscorify(),
