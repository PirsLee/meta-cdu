diff --git a/yaml/xyz/openbmc_project/Configuration/UARTPort.interface.yaml b/yaml/xyz/openbmc_project/Configuration/UARTPort.interface.yaml
new file mode 100644
index 0000000..3d393f9
--- /dev/null
+++ b/yaml/xyz/openbmc_project/Configuration/UARTPort.interface.yaml
@@ -0,0 +1,64 @@
+Description: >
+    Implement to provide entity manager configuration for the uart port.
+
+properties:
+    - name: Type
+      type: string
+      description: >
+          The type of configuration object.
+      flags:
+          - readonly
+    - name: Name
+      type: string
+      description: >
+          The name of the uart port.
+      flags:
+          - readonly
+    - name: DevicePath
+      type: string
+      description: >
+          The path of the UART, e.g. /dev/ttyS0 or /dev/ttyAMA0.
+      flags:
+          - readonly
+    - name: Mode
+      type: string
+      description: >
+          The mode of the serial interface, for example, RS232, RS485.
+      flags:
+          - readonly
+    - name: BaudRate
+      type: uint64
+      description: >
+          The baudrate of the communication channel.
+      flags:
+          - readonly
+    - name: Parity
+      type: string
+      description: >
+          The parity of the communication channel, for example, none, even, odd.
+      flags:
+          - readonly
+    - name: DataBits
+      type: uint64
+      description: >
+          The number of data bits of the communication channel.
+      flags:
+          - readonly
+    - name: StopBits
+      type: uint64
+      description: >
+          The number of stop bits of the communication channel.
+      flags:
+          - readonly
+    - name: FlowControl
+      type: string
+      description: >
+          The flow control of the communication channel, for example, none, rts/cts, xon/xoff.
+      flags:
+          - readonly
+    - name: RTSDelay
+      type: uint64
+      description: >
+          The request to send delay in milli-seconds.
+      flags:
+          - readonly
\ No newline at end of file
