     'modbus_rtu_port_lib',
-    ['port/base_port.cpp', 'port/port_factory.cpp', 'port/usb_port.cpp'],
+    ['port/base_port.cpp', 'port/port_factory.cpp', 'port/usb_port.cpp', 'port/uart_port.cpp'],
