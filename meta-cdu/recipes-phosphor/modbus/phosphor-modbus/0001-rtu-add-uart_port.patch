diff --git a/rtu/port/port_factory.cpp b/rtu/port/port_factory.cpp
index 467d18f..4ec3df8 100644
--- a/rtu/port/port_factory.cpp
+++ b/rtu/port/port_factory.cpp
@@ -1,8 +1,10 @@
 #include "port_factory.hpp"
 
 #include "usb_port.hpp"
+#include "uart_port.hpp"
 
 #include <xyz/openbmc_project/Configuration/USBPort/client.hpp>
+#include <xyz/openbmc_project/Configuration/UARTPort/client.hpp>
 
 namespace phosphor::modbus::rtu::port
 {
@@ -10,9 +12,13 @@ namespace phosphor::modbus::rtu::port
 using USBPortConfigIntf =
     sdbusplus::client::xyz::openbmc_project::configuration::USBPort<>;
 
+using UARTPortConfigIntf =
+    sdbusplus::client::xyz::openbmc_project::configuration::UARTPort<>;
+
 auto PortFactory::getInterfaces() -> std::vector<std::string>
 {
-    return {USBPortConfigIntf::interface};
+    return {USBPortConfigIntf::interface,
+            UARTPortConfigIntf::interface};
 }
 
 auto PortFactory::getConfig(sdbusplus::async::context& ctx,
@@ -25,6 +31,11 @@ auto PortFactory::getConfig(sdbusplus::async::context& ctx,
         co_return co_await USBPort::getConfig(ctx, objectPath);
     }
 
+    if (interfaceName == UARTPortConfigIntf::interface)
+    {
+        co_return co_await UARTPort::getConfig(ctx, objectPath);
+    }
+
     co_return std::nullptr_t();
 }
 
@@ -37,6 +48,11 @@ auto PortFactory::create(sdbusplus::async::context& ctx,
         return std::make_unique<USBPort>(ctx, config);
     }
 
+    if (config.portType == config::PortType::uart)
+    {
+        return std::make_unique<UARTPort>(ctx, config);
+    }
+
     return nullptr;
 }
 
diff --git a/rtu/port/port_factory.hpp b/rtu/port/port_factory.hpp
index a663e4a..7f13472 100644
--- a/rtu/port/port_factory.hpp
+++ b/rtu/port/port_factory.hpp
@@ -16,6 +16,7 @@ namespace config
 enum class PortType
 {
     usb,
