     unknown
 };
 
diff --git a/rtu/port/uart_port.cpp b/rtu/port/uart_port.cpp
new file mode 100644
index 0000000..0b863c8
--- /dev/null
+++ b/rtu/port/uart_port.cpp
@@ -0,0 +1,83 @@
+#include "uart_port.hpp"
+
+#include "common/entity_manager_interface.hpp"
+#include "port_factory.hpp"
+
+#include <fcntl.h>
+
+#include <phosphor-logging/lg2.hpp>
+#include <xyz/openbmc_project/Configuration/UARTPort/client.hpp>
+
+#include <filesystem>
+#include <format>
+#include <optional>
+
+namespace phosphor::modbus::rtu::port
+{
+PHOSPHOR_LOG2_USING;
+
+using UARTPortConfigIntf =
+    sdbusplus::client::xyz::openbmc_project::configuration::UARTPort<>;
+
+namespace config
+{
+    struct UARTPortConfig : public PortFactoryConfig
+    {
+        std::string address = "unknown";
+
+        virtual ~UARTPortConfig() = default;
+    };
+} // namespace config
+
+static auto getDevicePath(const config::PortFactoryConfig& inConfig)
+    -> std::string
+{
+    namespace fs = std::filesystem;
+    auto config = static_cast<const config::UARTPortConfig&>(inConfig);
+
+    std::string ttyPath = std::format("/dev/{}", config.address);
+
+    if (!fs::exists(ttyPath))
+    {
+        throw std::runtime_error(
+            std::format("/dev/{} does not exist", config.address));
+    }
+
+    return ttyPath;
+}
+
+UARTPort::UARTPort(sdbusplus::async::context& ctx,
+                     const config::PortFactoryConfig& config) :
+    BasePort(ctx, config, getDevicePath(config))
+{
+    info("UART port {NAME} created successfully", "NAME", config.name);
+}
+
+auto UARTPort::getConfig(sdbusplus::async::context& ctx,
+                          const sdbusplus::object_path& objectPath)
+    -> sdbusplus::async::task<std::unique_ptr<config::PortFactoryConfig>>
+{
+    auto config = std::make_unique<config::UARTPortConfig>();
+    if(!config)
+    {
+        co_return std::nullptr_t();
+    }
+    auto properties = 
+        co_await UARTPortConfigIntf(ctx)
+            .service(entity_manager::EntityManagerInterface::serviceName)
+            .path(objectPath.str)
+            .properties();
+
+    auto res = updateBaseConfig(*config, properties);
+    if(!res)
+    {
+        co_return std::nullptr_t();
+    }
+
+    config->portType = config::PortType::uart;
+    config->address = properties.device_address;
+
+    co_return config;
+}
+
+} // namespace phosphor::modbus::rtu::port
\ No newline at end of file
diff --git a/rtu/port/uart_port.hpp b/rtu/port/uart_port.hpp
new file mode 100644
index 0000000..4444401
--- /dev/null
+++ b/rtu/port/uart_port.hpp
@@ -0,0 +1,26 @@
+#pragma once
+
+#include "base_port.hpp"
+
+#include <sdbusplus/async.hpp>
+
+namespace phosphor::modbus::rtu::port
+{
+
+namespace config
+{
+    struct PortFactoryConfig;
+} // namespace config
+
+class UARTPort : public BasePort
+{
+    public:
+    explicit UARTPort(sdbusplus::async::context& ctx,
+                     const config::PortFactoryConfig& config);
+
+    static auto getConfig(sdbusplus::async::context& ctx,
+                          const sdbusplus::object_path& objectPath)
+        -> sdbusplus::async::task<std::unique_ptr<config::PortFactoryConfig>>;
+};
+
+} // namespace phosphor::modbus::rtu::port
\ No newline at end of file
